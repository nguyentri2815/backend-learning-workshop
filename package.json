{
  "name": "backend-learning-workshop",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite --host localhost --port 3182 --strictPort",
    "typecheck": "tsc --noEmit",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview --host localhost --port 3182 --strictPort",
    "test:browser": "playwright test",
    "verify:originals": "node scripts/verify-originals.mjs",
    "verify:fixtures": "node scripts/verify-fixtures.mjs",
    "fixtures:update": "node scripts/verify-fixtures.mjs --update"
  },
  "dependencies": {
    "@xyflow/react": "12.12.0",
    "diff": "9.0.0",
    "lucide-react": "1.64.0",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-resizable-panels": "4.15.2",
    "react-router-dom": "7.18.5",
    "shiki": "4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "5.9.3",
    "vite": "8.3.5"
  }
}
